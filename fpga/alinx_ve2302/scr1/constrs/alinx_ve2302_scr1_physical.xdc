set_property PACKAGE_PIN AB23 [get_ports {sys_clk_p[0]}]
set_property PACKAGE_PIN AC23 [get_ports {sys_clk_n[0]}]

set_property IOSTANDARD LVDS15 [get_ports {sys_clk_n[0]}]
set_property IOSTANDARD LVDS15 [get_ports {sys_clk_p[0]}]
create_clock -period 5.000 -name sys_clk -waveform {0.000 2.500} [get_ports {sys_clk_p[0]}]


# ---- Reset (CPU_RESETn) and status LED (heartbeat) ----
set_property PACKAGE_PIN F21 [get_ports CPU_RESETn]
set_property IOSTANDARD LVCMOS15 [get_ports CPU_RESETn]
set_property PACKAGE_PIN E20 [get_ports LED]
set_property IOSTANDARD LVCMOS15 [get_ports LED]

# ---- SCR1 core debug JTAG on PMOD J55 (bank B302, 3.3 V) for OpenOCD ----
set_property PACKAGE_PIN E14 [get_ports JTAG_TCK]
set_property PACKAGE_PIN D14 [get_ports JTAG_TMS]
set_property PACKAGE_PIN D12 [get_ports JTAG_TDI]
set_property PACKAGE_PIN E11 [get_ports JTAG_TDO]
set_property IOSTANDARD LVCMOS33 [get_ports JTAG_TCK]
set_property IOSTANDARD LVCMOS33 [get_ports JTAG_TMS]
set_property IOSTANDARD LVCMOS33 [get_ports JTAG_TDI]
set_property IOSTANDARD LVCMOS33 [get_ports JTAG_TDO]
# JTAG TCK is an independent ~10 MHz clock, asynchronous to the core clock.
create_clock -period 100.000 -name jtag_tck [get_ports JTAG_TCK]
set_clock_groups -asynchronous -group [get_clocks jtag_tck]
# JTAG_TCK is on a non-clock-capable HDIO pin (E14). Allow non-dedicated clock routing to
# its BUFG - it is a slow ~10 MHz JTAG clock, so sub-optimal routing is acceptable. This
# demotes Place 30-675 (IO Clock Placer failed) to a warning.
set_property CLOCK_DEDICATED_ROUTE FALSE [get_nets -hierarchical -filter {NAME =~ *JTAG_TCK_IBUF*}]

# ---- PL UART (axi_uart16550 @ 0xFF010000) on PMOD J55 (bank B302, 3.3 V) ----
# For an external USB-TTL adapter (3.3 V). Wiring: adapter GND->J55.5/6, adapter RXD->our
# TX (F14, J55.7), adapter TXD->our RX (E13, J55.8). scbl console @ ~115200 8N1.
set_property PACKAGE_PIN F14 [get_ports uart_txd]
set_property PACKAGE_PIN E13 [get_ports uart_rxd]
set_property IOSTANDARD LVCMOS33 [get_ports uart_txd]
set_property IOSTANDARD LVCMOS33 [get_ports uart_rxd]




